PORT=5004
MONGO_URL=mongodb://ai-mongo:27017/aiService
JWT_SECRET=change_me_shared_secret

# Optional. Leave blank to run on the built-in deterministic stub provider —
# every endpoint works fully without this, just with canned/heuristic output
# instead of real model output. Set this to switch to live Gemini responses,
# no code changes needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
